# ─────────────────────────────────────────────────────────────────────────────
# Twilio — Demo Account
# Find these at console.twilio.com → Account → API keys & tokens
# ─────────────────────────────────────────────────────────────────────────────

# Your Twilio Account SID (starts with AC)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio Auth Token (used server-side only — never expose to the browser)
TWILIO_AUTH_TOKEN=your_auth_token

# API Key SID + Secret — used to sign Voice SDK Access Tokens
# Create at console.twilio.com → Account → API keys & tokens → Create API key
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_api_secret

# The Twilio phone number callers dial into (E.164 format)
# Set its Voice webhook to: https://<HOST>/inbound
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# TwiML App SID — Voice SDK uses this to route outbound browser calls
# Create at console.twilio.com → Voice → TwiML Apps
# Set its Voice Request URL to: https://<HOST>/inbound
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# Microsoft Teams
# ─────────────────────────────────────────────────────────────────────────────

# E.164 number of the Teams user to transfer the call to
TEAMS_NUMBER=+61xxxxxxxxx

# How long (seconds) to ring Teams before falling back to Flex
TEAMS_DIAL_TIMEOUT=10

# ─────────────────────────────────────────────────────────────────────────────
# Flex Fallback — separate Twilio account with Flex enabled
# Used when Teams doesn't answer within TEAMS_DIAL_TIMEOUT
# See docs/whatsapp-flex-setup.md for full A2A setup instructions
# ─────────────────────────────────────────────────────────────────────────────

# Account SID of the Flex-enabled Twilio account
FLEX_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# TwiML Application SID inside the Flex account that receives the transferred call
FLEX_APPLICATION_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# OpenAI — ConversationRelay AI agent
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI API key — used to power the GPT-4o banking assistant
OPENAI_API_KEY=sk-...

# ─────────────────────────────────────────────────────────────────────────────
# Demo configuration
# ─────────────────────────────────────────────────────────────────────────────

# Greeting spoken to the caller at the start of each call (via ElevenLabs TTS)
GREETING_MESSAGE=Welcome to Teams Demo. How can I help you today?

# Password required to access the Voice SDK browser client at /
DEMO_PASSWORD=choose_a_strong_password

# ─────────────────────────────────────────────────────────────────────────────
# Hosting — Fly.io
# ─────────────────────────────────────────────────────────────────────────────

# Public hostname of this service — used to build WebSocket and action URLs
# e.g. teams-demo.fly.dev (no https:// prefix)
HOST=teams-demo.fly.dev

# Port the server listens on (Fly.io injects this; 3000 is the default)
PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# ConversationRelay — voice & transcription (all optional)
# Remove any of these to fall back to Twilio's defaults
# ElevenLabs TTS requires account enablement: console.twilio.com → Voice → ConversationRelay
# ─────────────────────────────────────────────────────────────────────────────

# TTS provider: ElevenLabs | Google | Amazon | Deepgram
CR_TTS_PROVIDER=ElevenLabs

# ElevenLabs voice ID (found in your ElevenLabs account)
CR_VOICE=your_elevenlabs_voice_id

# BCP-47 language tag for both TTS and ASR (e.g. en-AU, en-US, en-GB)
CR_LANGUAGE=en-AU

# ASR (transcription) provider: Deepgram | Google
CR_TRANSCRIPTION_PROVIDER=Deepgram

# Deepgram speech model — nova-2-general is optimised for telephone audio
# See https://developers.deepgram.com/docs/models-languages-overview
CR_SPEECH_MODEL=nova-2-general

# ─────────────────────────────────────────────────────────────────────────────
# Flex fallback — audio message played before transferring to associate team
# ─────────────────────────────────────────────────────────────────────────────

# Message spoken to the caller when Teams doesn't answer (before Flex transfer)
FLEX_TRANSFER_MESSAGE=I am sorry, the specialist is currently unavailable. Let me transfer you to our associate team who will be happy to help.

# TTS voice for the above message — Polly voices: https://docs.aws.amazon.com/polly/latest/dg/voicelist.html
# Polly.Olivia = Australian English female (neural), Polly.Russell = Australian English male
FLEX_TRANSFER_VOICE=Polly.Olivia-Neural

# ─────────────────────────────────────────────────────────────────────────────
# WhatsApp A2A — receiving transfers from the external WhatsApp/Flex account
# ─────────────────────────────────────────────────────────────────────────────

# TwiML App SID in THIS account created to receive A2A transfers.
# Its Voice URL is set to https://<HOST>/inbound.
# Point the external WhatsApp number's webhook to: https://<HOST>/whatsapp-inbound
WHATSAPP_A2A_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WhatsApp number shown on screen as an alternative call-in option (display only)
WHATSAPP_PHONE_NUMBER=+61xxxxxxxxx
